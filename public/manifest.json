{
  "manifest_version": 3,
  "name": "Wyzard — Reflowable & Visual E-Book Studio",
  "short_name": "Wyzard",
  "version": "1.1.1",
  "description": "Local-first WYSIWYG e-book & visual layout studio with Freeform 2D Vector Canvas & Multi-Format compilation (.EPUB 3.3, .PDF, .CBZ, Web .ZIP).",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Wyzard Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
